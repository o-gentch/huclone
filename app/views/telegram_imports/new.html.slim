= content_for :title, "Импорт из Telegram"
= content_for :narrow, true

= link_to "← Назад", persona_contents_path(@persona), class: "back"
h1.mt-3.mb-8 Импорт из Telegram

.alert.alert-warn
  p.font-semibold.mb-1 Как получить файл?
  ol.list-decimal.list-inside.space-y-1
    li Откройте Telegram Desktop
    li Перейдите в нужный канал или чат
    li Кликните на три точки → Экспорт истории чата
    li Выберите формат JSON, снимите галочки с медиафайлов
    li Загрузите полученный файл result.json ниже

- if flash[:error].present?
  .alert.alert-err = flash[:error]

= form_with url: persona_telegram_imports_path(@persona), multipart: true do |f|
  .field
    label.label Файл result.json
    = file_field_tag "import[file]", accept: ".json", class: "file"

  .flex.items-center.gap-3
    = submit_tag "Импортировать посты", class: "btn btn-primary"
    = link_to "Отмена", persona_contents_path(@persona), class: "link-muted"
