doctype html
html
  head
    title
      = content_for?(:title) ? yield(:title) : "Digital Double"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Digital Double"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/icon.png"
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=true
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  body
    - persona = current_persona if authenticated?

    .app
      - if persona
        aside.side
          .brand
            span.blob: i
            | Digital Double

          = button_to persona_conversations_path(persona), method: :post, class: "newchat", form: { class: "contents" } do
            | ＋ Новый чат

          nav.nav
            = nav_link "Библиотека", library_path, :library, "t-butter"

          .side-title Digital Doubles
          .recent
            - Current.user.personas.order(:id).each do |dd|
              = link_to dd.name, persona_contents_path(dd), class: ("on" if dd.id == persona.id)
            = link_to "＋ Новый Digital Double", new_persona_path

          .side-title = persona.name
          nav.nav
            = nav_link "Материалы", persona_contents_path(persona), :contents, "t-peach"
            = nav_link "Видео", persona_recordings_path(persona), :recordings, "t-lav"
            = nav_link "Темы", persona_topics_path(persona), :topics, "t-sage"
            = nav_link "Чат", persona_conversations_path(persona), :conversations, "t-sky"
            = nav_link "Настройки", edit_persona_path(persona), :personas, "t-rose"

          - recent = persona.conversations.order(created_at: :desc).limit(5)
          - if recent.any?
            .side-title Недавние чаты
            .recent
              - recent.each do |conversation|
                = link_to conversation_title(conversation), persona_conversation_path(persona, conversation),
                    class: ("on" if params[:id].to_s == conversation.id.to_s && controller_name == "conversations")

          .spacer.flex-1

          .me
            .ava = Current.user.email_address.to_s.first.to_s.upcase
            .me-text.min-w-0.flex-1
              b.block.font-semibold.leading-tight.truncate = Current.user.email_address.to_s.split("@").first
              - remaining = Recordings::Quota.remaining_minutes(Current.user)
              small.text-muted.text-xs Осталось #{remaining.floor} мин
              .quota
                i style="width: #{[ (remaining / Recordings::Quota.limit_minutes * 100).round, 100 ].min}%"
            = button_to session_path, method: :delete, class: "logout", title: "Выйти", form: { class: "contents" } do
              svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"

      main.main
        - if content_for?(:bare)
          - if notice.present?
            .alert.alert-ok.flash-bare = notice
          - if alert.present?
            .alert.alert-err.flash-bare = alert
          = yield
        - else
          div class=(content_for?(:narrow) ? "wrap-narrow" : "wrap")
            - if notice.present?
              .alert.alert-ok = notice
            - if alert.present?
              .alert.alert-err = alert
            = yield
