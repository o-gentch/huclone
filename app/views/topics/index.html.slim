= content_for :title, "Темы"

.page-head
  .page-head-l
    .tile.t-sage = section_icon(:topics)
    div
      h1 Темы
      .sub Дерево тем из ваших выступлений
  - if @tree.any?
    .flex.items-center.gap-2
      = button_to "Пересобрать", rebuild_persona_topics_path(@persona), class: "btn", form: { class: "contents" },
          data: { turbo_confirm: "Дерево будет построено заново, названия могут измениться. Продолжить?" }
      = link_to "Экспорт в Markdown", export_persona_topics_path(@persona), class: "btn btn-primary"

- if @tree.empty?
  .empty
    .tile.t-sage = section_icon(:topics)
    p Тем пока нет
    p.sub Они появятся после того, как вы загрузите и подтвердите записи выступлений
- else
  = render "topics/node", nodes: @tree, persona: @persona, prefix: ""
