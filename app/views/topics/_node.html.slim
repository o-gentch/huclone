- tones = %w[t-lav t-sage t-peach t-sky t-butter t-rose]
- nodes.each_with_index do |(topic, children), i|
  - number = "#{prefix}#{i + 1}"
  div id=dom_id(topic) class=("child" if topic.depth.positive?)
    .card.topic
      .num class=(topic.depth.positive? ? "t-sage" : tones[i % tones.size]) = number
      div
        h3 = topic.title
        - if topic.summary.present?
          p = topic.summary
        - if children.empty?
          - sources = topic.sources(limit: 10)
          - if sources.any?
            p.text-xs.text-faint.mt-3 Фрагменты (#{topic.sources.size})
            .links.mt-1
              - sources.each do |s|
                = link_to "«#{s[:title]}», #{Recording.format_ms(s[:start_ms].to_i)}",
                    persona_recording_path(persona, s[:recording_id], anchor: "t=#{s[:start_ms].to_i / 1000}")
    - if children.any?
      = render "topics/node", nodes: children, persona: persona, prefix: "#{number}."
