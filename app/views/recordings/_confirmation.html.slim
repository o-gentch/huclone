- total = speakers.sum(&:speech_ms)
- preselected = selected.presence || [ speakers.max_by(&:speech_ms).id ]
- low = recording.low_confidence_share

= form_with url: confirm_persona_recording_path(persona, recording), class: "mb-8" do
  h2.mb-1 Кто из говорящих — #{persona.name}?
  p.sub.mb-4 Послушайте фрагменты и отметьте всех, кто относится к этому Digital Double (можно несколько). Только их речь пойдёт в портрет и знания.
  - if low > 0.15
    .alert.alert-warn
      | Около #{(low * 100).round}% реплик распознаны неуверенно. Если голоса перепутаны, попробуйте перераспознать с указанием числа говорящих (ниже).

  - speakers.each do |speaker|
    label.card.sp
      .flex.items-start.gap-3
        = check_box_tag "speaker_ids[]", speaker.id, preselected.include?(speaker.id), id: "speaker_#{speaker.id}", class: "mt-1.5"
        .flex-1.min-w-0
          .flex.items-center.justify-between.gap-3
            span class="pill #{speaker_color(speaker)}" Спикер #{speaker.label}
            - if other_choices[speaker.id].present?
              span.text-xs.text-faint выбран у: #{other_choices[speaker.id].to_sentence}
            span.text-xs.text-faint.font-medium #{speaker.share(total)}% речи · #{speaker.words_count} слов
          = text_field_tag "names[#{speaker.id}]", speaker.display_name, placeholder: "Имя (необязательно), например «Ведущий»", maxlength: 60,
              class: "inp mt-2.5"
          ul.mt-3.space-y-2
            - speaker.sample_utterances.each do |u|
              li.flex.items-start.gap-2.5.text-sm.text-[#55526E]
                button.play type="button" data-action="audio-player#play" data-audio-player-start-param=(u.start_ms / 1000.0) data-audio-player-end-param=(u.end_ms / 1000.0) ▶ #{u.timecode}
                span = u.text.truncate(200)

  .flex.items-center.gap-3.mt-2
    = submit_tag "Сохранить", class: "btn btn-dark"
    = button_tag "Этого человека нет в записи", name: "none", value: "1", class: "btn"

= form_with url: reprocess_persona_recording_path(persona, recording), class: "flex items-center gap-2 mb-8 text-sm text-muted flex-wrap",
    data: { turbo_confirm: "Перераспознавание тратит минуты квоты. Продолжить?" } do
  span Голоса перепутаны?
  = number_field_tag "expected_speakers", recording.expected_speakers || speakers.size, min: 1, max: 10, class: "inp w-16! px-2! py-1!"
  span говорящих
  = submit_tag "Перераспознать", class: "btn btn-sm"
