- link = local_assigns[:persona_recording]
- shown = recording.transcribed? ? (link&.needs_speakers? ? "needs_speakers" : "ready") : recording.status
- tone = { "failed" => "t-rose", "ready" => "t-sage", "needs_speakers" => "t-butter" }.fetch(shown, "t-lav")
.card.row.row-link id=dom_id(recording)
  = link_to persona_recording_path(persona, recording), class: "flex items-center gap-3.5 min-w-0 flex-1" do
    .thumb class=tone
      = recording.duration_ms ? "#{(recording.duration_ms / 60_000.0).ceil}′" : "…"
    .grow
      .row-title = recording.title
      .row-meta
        = recording.created_at.strftime("%d.%m.%Y")
        - if recording.duration_ms
          |  · #{recording.duration_label}
      - if recording.failed? && recording.error_message.present?
        .row-err = recording.error_message
  = status_badge(shown)
  - if recording.failed? && recording.retryable?
    = button_to "Повторить", retry_persona_recording_path(persona, recording), class: "btn btn-sm", form: { class: "contents" }
  = button_to persona_recording_path(persona, recording), method: :delete, class: "x", title: "Удалить",
      data: { turbo_confirm: "Удалить запись «#{recording.title}»?" }, form: { class: "contents" } do
    svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
      path d="M6 18L18 6M6 6l12 12"
