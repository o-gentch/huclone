= content_for :title, @recording.title
= turbo_stream_from @recording, :page

= link_to "← Материалы", persona_contents_path(@persona), class: "back"
.page-head.mt-3
  .min-w-0
    h1.truncate = @recording.title
    .sub #{@recording.created_at.strftime('%d.%m.%Y')} · #{@recording.duration_label}
  = status_badge(@recording.status)

- if @recording.in_progress?
  .card.px-5.py-6.text-muted
    p
      - case @recording.status
      - when "uploaded", "extracting_audio"
        | Извлекаем звук из файла…
      - else
        | Расшифровываем запись. Для 20-минутного видео это занимает несколько минут — страница обновится сама.

- if @recording.failed?
  .alert.alert-err
    p = @recording.error_message.presence || "Не удалось обработать запись"
    - if @recording.retryable?
      = button_to "Повторить", retry_persona_recording_path(@persona, @recording), class: "btn btn-sm btn-danger mt-3"

- if @recording.audio_file.attached? && @speakers.any?
  div data-controller="audio-player"
    .card.player
      audio controls=true preload="metadata" data-audio-player-target="audio" data-action="timeupdate->audio-player#tick" src=audio_persona_recording_path(@persona, @recording)

    - if @recording.transcribed? && @persona_recording.needs_speakers?
      = render "recordings/confirmation", recording: @recording, persona: @persona, speakers: @speakers, selected: [], other_choices: @other_choices
    - elsif @recording.transcribed?
      .alert.alert-ok
        - mine = @speakers.select { |s| @persona_recording.speaker_ids.include?(s.id) }
        - if mine.any?
          | #{@persona.name}: #{mine.map(&:name).to_sentence}
        - else
          | Этого человека нет в записи — она не будет использована.
        = link_to "изменить", persona_recording_path(@persona, @recording, change: 1), class: "underline ml-2"
      - if params[:change]
        = render "recordings/confirmation", recording: @recording, persona: @persona, speakers: @speakers, selected: @persona_recording.speaker_ids, other_choices: @other_choices

    = render "recordings/transcript", utterances: @utterances, speakers: @speakers
