= content_for :title, "Видео"
= turbo_stream_from @persona, :recordings

.page-head
  .page-head-l
    .tile.t-lav = section_icon(:recordings)
    div
      h1 Видео
      .sub Записи выступлений и их расшифровки
  = link_to "＋ Загрузить", new_persona_recording_path(@persona), class: "btn btn-primary"

- if @recordings.empty?
  .empty
    .tile.t-lav = section_icon(:recordings)
    p Пока нет записей
    p.sub Загрузите видео или аудио своих выступлений — мы расшифруем их и найдём вашу речь
- else
  - @recordings.each do |recording|
    = render "recordings/recording", recording: recording, persona: @persona, persona_recording: @links[recording.id]
