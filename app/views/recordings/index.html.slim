= content_for :title, "Видео"
= turbo_stream_from @persona, :recordings

.w-full.max-w-3xl.mx-auto
  .flex.items-center.justify-between.mb-8
    h1 class="text-2xl font-semibold text-gray-900" Видео
    = link_to "Загрузить запись", new_persona_recording_path(@persona),
        class: "bg-gray-900 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors"

  - if @recordings.empty?
    .text-center.py-20.text-gray-400
      p class="text-lg" Пока нет записей
      p class="text-sm mt-1" Загрузите видео или аудио своих выступлений — мы расшифруем их и найдём вашу речь
  - else
    .space-y-3
      - @recordings.each do |recording|
        = render "recordings/recording", recording: recording, persona: @persona
