= content_for :title, "Загрузить запись"
= content_for :narrow, true

= link_to "← Назад", persona_recordings_path(@persona), class: "back"
h1.mt-3.mb-8 Загрузить запись

= form_with url: persona_recordings_path(@persona), multipart: true,
    data: { controller: "upload", action: "direct-upload:start->upload#start direct-upload:progress->upload#progress direct-upload:end->upload#end direct-upload:error->upload#error" } do |f|
  - if @recording.errors.any?
    .alert.alert-err
      = @recording.errors.full_messages.first

  .field
    label.label
      | Название
      small  (необязательно)
    = text_field_tag "recording[title]", @recording.title, placeholder: "Например: Выступление на конференции", class: "inp"

  .field
    label.label Файл
    .drop
      = file_field_tag "recording[source_file]",
          accept: "video/*,audio/*", data: { upload_target: "input", direct_upload_url: rails_direct_uploads_url },
          class: "file"
      p.hint
        | mp4, mov, webm, mkv, mp3, m4a, wav, ogg. До #{Recording.max_upload_label}, не длиннее 3 часов.
        - if Recording.local_storage?
          |  Файлы хранятся на диске сервера, поэтому размер ограничен.
      p.hint Осталось в этом месяце: #{Recordings::Quota.remaining_minutes(Current.user).floor} мин
    div class="hidden" data-upload-target="progressWrap"
      .progress
        div style="width: 0%" data-upload-target="bar"
      p.hint data-upload-target="label" Загрузка…

  .field
    label.label
      | Сколько людей говорит в записи
      small  (необязательно)
    = number_field_tag "recording[expected_speakers]", @recording.expected_speakers, min: 1, max: 10, class: "inp w-28!"
    p.hint Помогает точнее разделить голоса

  = submit_tag("Загрузить", data: { upload_target: "submit", disable_with: false },
      class: "btn btn-primary")
