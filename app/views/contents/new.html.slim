= content_for :title, "Добавить текст"
= content_for :narrow, true

= link_to "← Назад", persona_contents_path(@persona), class: "back"
h1.mt-3.mb-8 Добавить текст

= form_with url: persona_contents_path(@persona), multipart: true do |f|
  - if @content.errors.any?
    .alert.alert-err = @content.errors.full_messages.first

  .field
    label.label
      | Название
      small  (необязательно)
    = text_field_tag "content[title]", nil, placeholder: "Например: Пост про маятник", class: "inp"

  .field
    label.label Текст
    = text_area_tag "content[body]", nil, placeholder: "Вставьте текст поста, статьи или конспекта...", rows: 12, class: "inp"

  .divider или загрузите файл

  .field
    label.label
      | Файл
      small  (.txt, .md)
    = file_field_tag "content[file]", accept: ".txt,.md", class: "file"

  .flex.items-center.gap-3.flex-wrap
    = submit_tag "Добавить и обработать", class: "btn btn-primary"
    = submit_tag "Сохранить и добавить ещё", name: "add_more", class: "btn"
    = link_to "Отмена", persona_contents_path(@persona), class: "link-muted"
