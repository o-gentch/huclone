= content_for :title, "Контент"

.page-head
  .page-head-l
    .tile.t-peach = section_icon(:contents)
    div
      h1 Контент
      .sub Тексты, на которых учится аватар
  .flex.items-center.gap-2
    = link_to "Импорт из Telegram", new_persona_telegram_import_path(@persona), class: "btn"
    = link_to "＋ Добавить текст", new_persona_content_path(@persona), class: "btn btn-primary"

- if @links.empty?
  .empty
    .tile.t-peach = section_icon(:contents)
    p Пока нет текстов
    p.sub Добавьте посты, статьи или конспекты — аватар научится на них
- else
  - @links.each do |link|
    - content = link.content
    .card.row id=dom_id(content)
      .grow
        .row-title = content.title
        .row-meta = content.created_at.strftime("%d.%m.%Y")
      - if link.is_exemplar
        span.badge.b-warn эталон
      = status_badge(content.status)
      = button_to persona_content_path(@persona, content), method: :delete, class: "x", title: "Удалить",
          data: { turbo_confirm: "Удалить «#{content.title}»?" }, form: { class: "contents" } do
        svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          path d="M6 18L18 6M6 6l12 12"
