- user_message = message.role == "user"

- if user_message
  div id=dom_id(message) class="msg-u"
    div = simple_format message.body, {}, wrapper_tag: "span"
- else
  div id=dom_id(message) class="msg-a"
    span.blob.blob-sm: i
    .msg-body
      div id="message_#{message.id}_body"
        - if message.body.blank?
          span.typing: i: i: i
        - else
          = simple_format message.body, {}, wrapper_tag: "span"
      div id="message_#{message.id}_sources"
        = render "conversations/sources", message: message, persona: message.conversation.persona
