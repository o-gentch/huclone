div id="message_form"
  = form_with url: persona_conversation_messages_path(persona, conversation),
      scope: :message,
      data: { action: "turbo:submit-start->chat#onSubmit" } do |f|

    .composer
      = f.text_area :body,
          placeholder: "Напишите сообщение…",
          rows: 2,
          data: { chat_target: "input", action: "keydown->chat#onKeydown input->chat#onInput" }

      .composer-bar
        .seg
          - Message::MODES.each do |m|
            label
              = f.radio_button :mode, m, checked: (mode == m), class: "sr-only", id: "mode_#{m}"
              span
                - case m
                - when "strict"
                  | По материалам
                - when "ideas"
                  | Идеи
                - else
                  | Книга
        button.send type="submit" title="Отправить"
          svg viewBox="0 0 24 24"
            path d="M12 19V5M5 12l7-7 7 7"
