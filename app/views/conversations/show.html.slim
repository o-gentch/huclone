= content_for :title, "Чат"
= content_for :bare, true

= turbo_stream_from @conversation

.chat data-controller="chat"
  .chat-scroll id="messages" data-chat-target="messages"
    - if @messages.empty?
      #empty-state.hello
        .blob.blob-lg: i
        h1
          | Привет! 
          br
          span О чём поговорим?
        .ideas
          button.idea.t-butter type="button" data-action="chat#fill" data-chat-text-param="Придумай тему для следующего поста" data-chat-mode-param="ideas"
            span Придумай тему для следующего поста
            small Идеи
          button.idea.t-sage type="button" data-action="chat#fill" data-chat-text-param="Что я говорил про " data-chat-mode-param="strict"
            span Что я говорил про…
            small По материалам
          button.idea.t-peach type="button" data-action="chat#fill" data-chat-text-param="Собери главу книги про " data-chat-mode-param="book"
            span Собери главу книги из моих выступлений
            small Книга
    - else
      - @messages.each do |message|
        = render "message", message: message

  .composer-wrap
    = render "form", persona: @persona, conversation: @conversation, mode: "strict"
