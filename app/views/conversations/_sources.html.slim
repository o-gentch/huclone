- if message.sources.present?
  .src
    span.src-label Источники
    - message.sources.each do |s|
      - if s["recording_id"]
        = link_to s["label"], persona_recording_path(persona, s["recording_id"], anchor: ("t=#{s['start_ms'] / 1000}" if s["start_ms"]))
      - else
        span.chip = s["label"]
